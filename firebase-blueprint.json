{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Enterprise Patient Record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "mrn": { "type": "string", "maxLength": 50 },
        "nameEn": { "type": "string", "maxLength": 200 },
        "nameAr": { "type": "string", "maxLength": 200 },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "phone": { "type": "string", "maxLength": 20 },
        "status": { "type": "string" },
        "insurance": { "type": "string" },
        "insuranceProviderId": { "type": "string" },
        "policyNo": { "type": "string" }
      },
      "required": ["id", "mrn", "nameEn", "nameAr"]
    },
    "Visit": {
      "title": "Clinical Visit",
      "description": "A single clinical encounter",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "patientId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "discharged", "cancelled"] },
        "currentStage": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "doctorId": { "type": "string" }
      },
      "required": ["id", "patientId", "status"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Security audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" }
      },
      "required": ["id", "timestamp", "userId", "action"]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Main patient records"
    },
    "/his_visits/{visitId}": {
      "schema": "Visit",
      "description": "Active clinical visits"
    },
    "/his_audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable security audit logs"
    }
  }
}
